# على جهازك: انسخ هذا الملف باسم .env وعبّي القيم.
# على Railway: حط القيم في Variables بدال ملف .env (المطلوب بس أول 3 مفاتيح).
# لا ترسل ملف .env لأحد ولا ترفعه على GitHub — فيه مفاتيحك.

# ================= ديسكورد =================
# توكن البوت: Discord Developer Portal → تطبيقك → Bot → Reset Token
DISCORD_TOKEN=

# ================= عقل البوت: Claude =================
# مفتاح من https://platform.claude.com (لازم يكون في الحساب رصيد API)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 الأسرع ويناسب الصوت — claude-sonnet-5-5 أذكى بس أبطأ شوي
ANTHROPIC_MODEL=claude-haiku-5-5
# true = يقدر يبحث في النت (أخبار، طقس، نتايج). كل بحث له تكلفة بسيطة
WEB_SEARCH=false

# ================= اسم البوت ومتى يرد =================
BOT_NAME=كلود
# أسماء ثانية ينتبه لها البوت غير اسمه (افصل بينها بفاصلة)
WAKE_WORDS=كلود,كلاود,claude,بوت
# name = يرد بس لما تناديه باسمه | everyone = يرد على أي كلام في الروم
REPLY_MODE=name
# بعد ما يرد عليك، كم ثانية تقدر تكمل كلامك معه بدون ما تناديه
FOLLOWUP_SECONDS=15
# كلمات توقفه وهو يتكلم (كلمة وحدة لكل وحدة)
STOP_WORDS=اسكت,خلاص,بس,وقف,كفايه,stop

# ================= تحويل الصوت لنص (السمع) =================
# groq = سريع ورخيص (فيه خطة مجانية) | openai
STT_PROVIDER=groq
# ar = يتوقع كلام عربي | auto = يكتشف اللغة بنفسه
STT_LANGUAGE=ar

# ================= صوت البوت (الكلام) =================
# groq       = أصوات عربية بلهجة سعودية/خليجية (نفس مفتاح Groq)
# azure      = أصوات إماراتية: حمدان وفاطمة (فيه خطة مجانية)
# elevenlabs = أصوات طبيعية جداً (مدفوع)
TTS_PROVIDER=groq

# ---------- Groq ----------
# مفتاح من https://console.groq.com/keys
GROQ_API_KEY=
# أصوات رجالية: sultan, fahad, abdullah — أصوات نسائية: noura, lulwa, aisha
GROQ_VOICE_AR=sultan
GROQ_VOICE_EN=troy

# ---------- OpenAI (بس إذا STT_PROVIDER=openai) ----------
OPENAI_API_KEY=

# ---------- Azure (بس إذا TTS_PROVIDER=azure) ----------
AZURE_SPEECH_KEY=
# نفس المنطقة اللي سويت فيها الـ Speech resource
AZURE_SPEECH_REGION=uaenorth
# ar-AE-HamdanNeural (رجالي) أو ar-AE-FatimaNeural (نسائي)
AZURE_VOICE_AR=ar-AE-HamdanNeural
AZURE_VOICE_EN=en-US-GuyNeural

# ---------- ElevenLabs (بس إذا TTS_PROVIDER=elevenlabs) ----------
ELEVENLABS_API_KEY=
# اختر صوت عربي من Voice Library وانسخ الـ Voice ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ================= إضافات =================
# آيدي روم صوتي يدشه البوت تلقائياً ويبقى فيه
# (فعّل Developer Mode في ديسكورد → كليك يمين على الروم → Copy Channel ID)
AUTO_JOIN_CHANNEL_ID=
# يطلع إذا الروم فضى لهالمدة بالثواني (0 = ما يطلع)
LEAVE_WHEN_ALONE_SECONDS=60
# يكتب السؤال والجواب في شات الروم الصوتي
POST_TRANSCRIPTS=true
TIMEZONE=Asia/Dubai
# true = رسائل تفصيلية في الكونسول لحل المشاكل
DEBUG=false
