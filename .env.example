# على جهازك: انسخ هذا الملف باسم .env وعبّي القيم.
# على Railway: حط القيم في Variables بدال ملف .env.
# لا ترسل ملف .env لأحد ولا ترفعه على GitHub — فيه مفاتيحك.

# ================= المطلوب =================
# توكن البوت: Discord Developer Portal → تطبيقك → Bot → Reset Token
DISCORD_TOKEN=
# مفتاح Groq المجاني: https://console.groq.com/keys
# (البوت يسمعكم عن طريقه، وهو الاحتياط إذا Gemini وقف)
GROQ_API_KEY=

# ================= Gemini (اختياري، ننصح فيه) =================
# مفتاح Gemini المجاني: https://aistudio.google.com/apikey
# إذا حطيته: Gemini يصير عقل البوت وصوته، وGroq يكمل بداله لو خلص حد Gemini.
GEMINI_API_KEY=
# موديل الردود الأول: gemini-3.5-flash-lite (سريع، وحده المجاني حوالي 500 باليوم) — gemini-3.8-flash أذكى بس حده 20 باليوم
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# موديل الصوت: gemini-3.8-flash-tts (أحلى) أو gemini-3.8-flash-lite-tts (أرخص)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# موديلات صوت Gemini الاحتياط (نفس الصوت، كل واحد بحده اليومي) — none = بدون
# GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
# auto = يصمم صوت بنت إماراتية مرة وحدة ويستخدمه دايماً
# أو اسم صوت جاهز: Leda, Kore, Aoede, Zephyr, Sulafat … أو آيدي صوت (voice_…)
GEMINI_VOICE=auto
# كيف تنطق كل جملة (الافتراضي: حيوي ونشيط وسريع، مب نعسان) — none = بدون
# GEMINI_VOICE_STYLE=
# تقص السكتات قبل وبعد الكلام والوقفات الطويلة (أطول وقفة بالملي ثانية)
# VOICE_TIGHT=true
# VOICE_MAX_PAUSE_MS=280

# ================= اسم البوت ومتى يرد =================
# اسم البوت — نادوها «فطوم» عشان ترد
BOT_NAME=فطوم
# أسماء ثانية تنتبه لها (افصل بينها بفاصلة)
WAKE_WORDS=فطوم,فطومه,فطومي,فاطوم,بوت,bot
# ردها لما تنادونها باسمها بس (تختار وحدة منها كل مرة — افصل بينها بفاصلة)
ACK_REPLIES=ها حياتي,هلا ابوي تفضل,ها عيوني شي؟
# name = ترد بس لما تنادونها باسمها | everyone = ترد على أي كلام في الروم
REPLY_MODE=name
# بعد ما ترد عليك، كم ثانية تقدر تكمل كلامك معها بدون ما تناديها
FOLLOWUP_SECONDS=15
# تكمل الكلام بدون اسمها بس إذا في الروم هالعدد من الناس أو أقل (في الزحمة لازم تنادونها)
FOLLOWUP_MAX_PEOPLE=2
# في الروم الزحمة: اللي ردت عليه يقدر يسأل سؤال ثاني بدون اسمها خلال هالثواني
# FOLLOWUP_BIG_SECONDS=10
# كلمات توقفها وهي تتكلم: «اسكتي/وقفي» أو مع اسمها من أي واحد؛ «بس/خلاص» بروحها بس من اللي تكلمه (أو في الروم الصغير)
STOP_WORDS=اسكتي,سكتي,اسكت,وقفي,وقف,خلاص,بس,بسج,كفايه,stop

# ================= العقل =================
# Groq وGemini يحسبون الحد المجاني لكل موديل، فمن نفس المفتاحين تطلع عدة عقول (كل واحد بحده):
#   gemini (GEMINI_CHAT_MODEL) · groq (GROQ_CHAT_MODEL) · geminilite (gemini-3.1-flash-lite) · groq20b (openai/gpt-oss-20b)
#   groqqwen (qwen/qwen3.8-27b) · geminiflash (gemini-3.6-flash) · gemini38 (gemini-3.8-flash)
# الصوت يسأل: gemini ← groq ← geminilite ← groq20b ← groqqwen ← mistral ← geminiflash ← cerebras ← openrouter ← sambanova ← gemini38
# الشات يسأل بترتيب ثاني (geminilite ← geminiflash ← groqqwen ← mistral ← ...) عشان ما يخلص حدود الصوت.
# إذا الأول وقف أو تأخر، اللي بعده يرد، وأول جواب يربح. تغيير موديل أي واحد: <NAME>_CHAT_MODEL (none = طافي)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# أطول رد للصوت / للشات (Groq يحسبه من حده بالدقيقة، فالصغير يخليها ترد أكثر)
# MAX_REPLY_TOKENS=400
# TEXT_MAX_REPLY_TOKENS=700

# ================= عقول من خدمات ثانية (كلها مجانية، كل وحدة تشتغل لحالها أول ما تحط مفتاحها) =================
# Cerebras (سريع جداً): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_CHAT_MODEL=gpt-oss-120b
# OpenRouter (موديلات مجانية، آخرها :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=openrouter/free   # الموديل المجاني القديم انحذف، هذا يختار موديل مجاني شغال
# Mistral (مجاني، يحتاج تحقق برقم الجوال): https://console.mistral.ai
MISTRAL_API_KEY=
# MISTRAL_CHAT_MODEL=mistral-small-latest
# SambaNova: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# SAMBANOVA_CHAT_MODEL=Meta-Llama-3.3-70B-Instruct
# أي خدمة ثانية بنفس صيغة OpenAI (العنوان الكامل ينتهي بـ /chat/completions)
# CUSTOM_LLM_URL=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=
# ترتيبك أنت بدل التلقائي: العقل الأول، وبعده الاحتياط (مثلاً: cerebras,gemini) — none = بدون احتياط
# LLM_PROVIDER=
# LLM_FALLBACK=

# ================= السمع: تحويل الصوت لنص =================
# groq (مجاني) | openai
STT_PROVIDER=groq
# ar = يتوقع كلام عربي | auto = يكتشف اللغة بنفسه
STT_LANGUAGE=ar

# ================= الصوت: تحويل النص لصوت =================
# الافتراضي: azure إذا في AZURE_SPEECH_KEY (أوضح وأسرع صوت إماراتي، وحده المجاني الشهري كبير)، وإلا gemini، وإلا groq
# elevenlabs = أصوات طبيعية جداً (يحتاج مفتاح ElevenLabs)
# TTS_PROVIDER=
# أصوات الاحتياط بالترتيب إذا الصوت الأول فشل أو خلص حده (الافتراضي: gemini,azure,groq اللي لها مفاتيح)
# none = بدون احتياط
# TTS_FALLBACK=
# أصوات Groq النسائية: noura, lulwa, aisha — الرجالية: sultan, fahad, abdullah
GROQ_VOICE_AR=noura
GROQ_VOICE_EN=hannah
# يعلّي الصوت إذا كان واطي
VOICE_LOUDER=true

# ---------- OpenAI (بس إذا STT_PROVIDER=openai) ----------
OPENAI_API_KEY=

# ---------- Azure: صوت إماراتي (ar-AE-FatimaNeural). يشتغل كاحتياط أول إذا حطيت المفتاح ----------
AZURE_SPEECH_KEY=
# نفس المنطقة اللي سويت فيها الـ Speech resource
AZURE_SPEECH_REGION=uaenorth
# سرعة صوت Azure (+10% أسرع شوي من العادي)
# AZURE_RATE=+10%
# ar-AE-FatimaNeural (نسائي) أو ar-AE-HamdanNeural (رجالي)
AZURE_VOICE_AR=ar-AE-FatimaNeural
AZURE_VOICE_EN=en-US-JennyNeural

# ---------- ElevenLabs (بس إذا TTS_PROVIDER=elevenlabs) ----------
ELEVENLABS_API_KEY=
# اختر صوت عربي من Voice Library وانسخ الـ Voice ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ================= إضافات =================
# آيدي روم صوتي يدشه البوت تلقائياً ويبقى فيه
# (فعّل Developer Mode في ديسكورد → كليك يمين على الروم → Copy Channel ID)
AUTO_JOIN_CHANNEL_ID=
# يطلع إذا الروم فضى لهالمدة بالثواني (0 = ما يطلع)
LEAVE_WHEN_ALONE_SECONDS=60
# يكتب السؤال والجواب في شات الروم الصوتي (مفيد إذا خلص حد الصوت المجاني)
POST_TRANSCRIPTS=true
TIMEZONE=Asia/Dubai
# true = يحط صورة avatar.png للبوت حتى لو عنده صورة (مرة وحدة، بعدين رجعها false)
BOT_AVATAR_UPDATE=false
# true = رسائل تفصيلية في الكونسول لحل المشاكل
DEBUG=false

# ---- السرعة ----
# موديلات Whisper الاحتياط إذا الأول وصل حده (Groq: 20 طلب بالدقيقة لكل موديل) — none = بدون
# STT_FALLBACK_MODELS=whisper-large-v3
# آخر احتياط للسمع: Voxtral من Mistral (يحتاج MISTRAL_API_KEY) — false = طافي
# STT_MISTRAL=true
# سؤال انتظر أكثر من هالثواني (كانت مشغولة) تتركه بدل ما ترد متأخر
# STALE_SECONDS=40
# كم ملي ثانية تنتظر بعد ما تسكت قبل ما ترد (أقل = أسرع، بس ممكن تقاطعك إذا وقفت تفكر)
# SILENCE_MS=500
# إذا Gemini أبطأ من هالوقت، يشتغل Groq معه وأول جواب يربح (0 = طافي)
# LLM_HEDGE_MS=500
# صوت Gemini يبدأ ينطق أول ما توصل أول قطعة صوت (بدون ما ينتظر الصوت كامل). false = طافي
# TTS_STREAM=true

# البوت يكتب في شات الروم الصوتي (الإعلان، السؤال والجواب، الأخطاء)؟ الافتراضي false: كل شي يطلع في الـ Logs بس
# CHAT_MESSAGES=false

# ---- الذاكرة ----
# تتذكر منو في الروم، واللي يقولونه لها عن نفسهم وعن السيرفر (اسمه، شغله، اللي يحبه...). false = طافي
# REMEMBER_PEOPLE=true
# وين تنحفظ الذاكرة. على Railway حط Volume على /app/data عشان ما تضيع مع كل نشر (وأضف RAILWAY_RUN_UID=0)
# DATA_DIR=data

# ---- الشات العام (كتابة) ----
# آيدي روم الشات (أو أكثر بفاصلة). none = طافي. لازم تفعّل Message Content Intent من Developer Portal
# TEXT_CHANNEL_IDS=1557103411579850852
# name = بس إذا نادوها/منشنوها/ردوا عليها، questions = وكمان الأسئلة اللي مو لأحد ثاني، everyone = كل شي
# TEXT_REPLY_MODE=questions
# كم ثانية تكمل مع اللي رددت عليه بدون ما ينادي، والفاصل بين ردودها
# TEXT_FOLLOWUP_SECONDS=20
# كم سؤال ورا بعض بدون اسمها (بعدها لازم ينادونها)
# TEXT_FOLLOWUPS_IN_A_ROW=2
# سؤال مفتوح للكل (مو لها): ترد عليه مرة كل هالثواني بالكثير
# TEXT_COOLDOWN_SECONDS=90
# البوتات الثانية اللي تسولف معها (أسماء أو آيدي بفاصلة). ترد بس إذا ناداها، وأقصى عدد ردود ورا بعض
# FRIEND_BOTS=حسون,hassoun
# TEXT_BOT_CHAIN_MAX=3
# TEXT_BOT_COOLDOWN_SECONDS=6
# كم يوم يغيب الواحد قبل ما يعتبرونه "مختفي"
# QUIET_DAYS=3

# ---- ميزات الروم ----
# ترحب باسم اللي يدخل الروم. {name} مكان الاسم، وافصل بين الجمل بفاصلة
# WELCOME=true
# WELCOME_REPLIES=هلا والله {name},يا هلا والله {name},هلا {name} مرحبا
# WELCOME_COOLDOWN_SECONDS=180
# «وعليكم السلام» لنفس الشخص مرة وحدة خلال هالثواني (في أي روم)
# SALAM_COOLDOWN_SECONDS=600
# true = تسكت إذا أحد بدأ يتكلم فوقها. الافتراضي false: تكمل كلامها («فطوم اسكتي» توقفها)
# BARGE_IN=false
# BARGE_IN_MS=500
# "فطوم روحي روم القهوة": تنتقل بين الرومات بالصوت
# MOVE_BY_VOICE=true

# ---- معلومات حديثة (أخبار، طقس، أسعار، نتايج، مواقيت صلاة) ----
# auto = تبحث في جوجل بس للأسئلة اللي تحتاج، always = دايماً (أبطأ)، off = طافي
# WEB_SEARCH=auto
# كلمات زيادة تخليها تبحث (بفاصلة)
# SEARCH_WORDS=
# البحث ياخذ وقت، فالاحتياط (Groq بدون بحث) ينتظر أكثر لأسئلة البحث
# SEARCH_HEDGE_MS=8000
